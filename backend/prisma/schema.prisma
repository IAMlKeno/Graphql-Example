generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://postgres:postgres@db:5432/quotes_db"
}

model incompletequotes {
  id             String          @id(map: "incomplete_quotes_pk") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fields         Json?           @db.Json
  ownerid        String          @db.Uuid
  estimate       Decimal?        @db.Decimal
  insurance_type insurance_type?
  users          users           @relation(fields: [ownerid], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "incompletequote_owner_fk")
}

model quotes {
  id             String         @id(map: "quotes_pk") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  insurance_type insurance_type
  date_submitted DateTime       @default(dbgenerated("CURRENT_DATE")) @db.Date
  estimate       Decimal        @db.Decimal
  ownerid        String         @db.Uuid
  users          users          @relation(fields: [ownerid], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "quote_owner_fk")
}

model users {
  id               String             @id(map: "users_pk") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fname            String             @db.VarChar
  lname            String             @db.VarChar
  dob              DateTime           @db.Date
  email            String             @unique(map: "users_unique")
  incompletequotes incompletequotes[]
  quotes           quotes[]
}

enum insurance_type {
  automotive
  home
  life
}
